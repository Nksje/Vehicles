<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Vehicles.AvaloniaApp.MainWindow"
        Title="Vehicles – garaažid" Width="860" Height="700">
    <Grid Margin="10" RowDefinitions="Auto,*" ColumnDefinitions="*,10,*">

        <!-- Autode garaaž -->
        <Border Grid.Row="0" Grid.Column="0" Padding="10" CornerRadius="4"
                BorderThickness="1" BorderBrush="Gray">
            <StackPanel Spacing="5">
                <TextBlock Text="Autode garaaž" FontSize="16" FontWeight="Bold" />

                <TextBlock Text="Nimi:" />
                <TextBox x:Name="CarNameTextBox" />

                <TextBlock Text="Tüüp:" />
                <ComboBox x:Name="CarTypeComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Car" />
                    <ComboBoxItem Content="AmphibiousCar" />
                </ComboBox>

                <Button Content="Lisa garaaži" Click="AddCarButton_Click" HorizontalAlignment="Stretch" />

                <ListBox x:Name="CarsListBox" Height="150"
                         SelectionChanged="VehicleListBox_SelectionChanged" />

                <TextBlock Text="Vahemaa (km):" />
                <TextBox x:Name="CarDistanceTextBox" Text="10" />

                <Grid ColumnDefinitions="*,5,*">
                    <Button Grid.Column="0" Content="Move" Click="MoveCarButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="Eemalda" Click="RemoveCarButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Paatide garaaž -->
        <Border Grid.Row="0" Grid.Column="2" Padding="10" CornerRadius="4"
                BorderThickness="1" BorderBrush="Gray">
            <StackPanel Spacing="5">
                <TextBlock Text="Paatide garaaž" FontSize="16" FontWeight="Bold" />

                <TextBlock Text="Nimi:" />
                <TextBox x:Name="BoatNameTextBox" />

                <Button Content="Lisa garaaži" Click="AddBoatButton_Click" HorizontalAlignment="Stretch" />

                <ListBox x:Name="BoatsListBox" Height="150"
                         SelectionChanged="VehicleListBox_SelectionChanged" />

                <TextBlock Text="Vahemaa (km):" />
                <TextBox x:Name="BoatDistanceTextBox" Text="10" />

                <Grid ColumnDefinitions="*,5,*">
                    <Button Grid.Column="0" Content="Move" Click="MoveBoatButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="Eemalda" Click="RemoveBoatButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Logi -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0"
              RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="Logi:" FontWeight="Bold" Margin="0,0,0,5" />
            <ListBox Grid.Row="1" x:Name="LogListBox" MinHeight="150" />
        </Grid>
    </Grid>
</Window>
